# prover type: mock, network, cpu
PROVER_TYPE=mock
PROVER_SP1_KEY=

# for agg-sender, true or false, default is false
FORCE_STOP_BLOCK=true

# using local agglayer, false and true
LOCAL_AGGLAYER=false


