# Environment variables for test-shadow-fork setup
# Copy this file to .env and fill in the values

# SP1 Private Key (will be read from conf/sp1.key file)
# This should be set by reading the file: SP1_KEY=$(cat conf/sp1.key)
SP1_KEY=

# Network configuration
NETWORK_RPC_URL=https://rpc.production.succinct.xyz

# Rust backtrace for debugging
RUST_BACKTRACE=1

# PostgreSQL configuration
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_DB=test_db

# Anvil configuration
ANVIL_BLOCK_TIME=12
ANVIL_FORK_URL=https://rpc.ankr.com/eth/
ANVIL_FORK_BLOCK_NUMBER=22688021

# Container resource limits
UPGRADE_PREPARATION_MEMORY_LIMIT=4g
UPGRADE_PREPARATION_MEMORY_SWAP=8g 